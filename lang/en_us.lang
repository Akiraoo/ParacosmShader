render_pipeline.module.main_render.attribute.post_rain_splash_scattering_percent.description=Controls the color and edge brightness of rain and splash particles.
render_pipeline.module.main_render.attribute.sun_indirect_light_multiplier=Sun indirect light multiplier
render_pipeline.module.main_render.attribute.sun_indirect_light_multiplier.description=Controls indirect illumination from bounced sunlight and the daytime sky.
render_pipeline.module.main_render.attribute.moon_indirect_light_multiplier=Moon indirect light multiplier
render_pipeline.module.main_render.attribute.moon_indirect_light_multiplier.description=Controls indirect illumination from bounced moonlight and the night sky.

render_pipeline.module.main_render.attribute.rain_wetness=Rain-wet ground
render_pipeline.module.main_render.attribute.rain_wetness.description=Controls the wet appearance of ground materials during rain.
render_pipeline.module.main_render.attribute.sunlight_strength=Sunlight Strength
render_pipeline.module.main_render.attribute.sunlight_strength.description=Controls direct sunlight only (not sky light). Higher values give brighter sunlit areas and more contrast against shadows.
render_pipeline.module.main_render.attribute.atmosphere_haze=Atmospheric Haze
render_pipeline.module.main_render.attribute.atmosphere_haze.description=Controls the grey/white haze in the air. Lower values give clearer, bluer distances; 1.0 matches the original Advanced pack.
render_pipeline.module.main_render.attribute.god_rays_strength=God Rays Strength
render_pipeline.module.main_render.attribute.god_rays_strength.description=Controls the brightness of sun shafts and the glow around the sun in the air.
render_pipeline.module.main_render.attribute.far_fog_mode=Distant Fog
render_pipeline.module.main_render.attribute.far_fog_mode.off=Off
render_pipeline.module.main_render.attribute.far_fog_mode.outdoors=Outdoors Only
render_pipeline.module.main_render.attribute.far_fog_mode.always=Always
render_pipeline.module.main_render.attribute.far_fog_mode.description=Sky-lit fog beyond 50 blocks. It only knows the sky, so in caves it showed up as a bright blue veil over dark tunnels. Outdoors Only: fades out when you are enclosed (caves, houses). Always: the original behaviour. Nearby haze is not affected.
render_pipeline.module.main_render.attribute.water_wave_height=Water Swell Height
render_pipeline.module.main_render.attribute.water_wave_height.description=Controls large, slow waves. Lower values give calmer water with clearer reflections; 1.0 matches the original Advanced pack.
render_pipeline.module.main_render.attribute.water_ripple_strength=Water Ripple Strength
render_pipeline.module.main_render.attribute.water_ripple_strength.description=Controls small ripples that make reflections sparkle and caustics sharper.
render_pipeline.module.main_render.attribute.post_underwater_effects=Underwater Lens Effects
render_pipeline.module.main_render.attribute.post_underwater_effects.description=Blurs and gently distorts the view while the camera is underwater.
render_pipeline.module.main_render.attribute.underwater_blur=Underwater Blur
render_pipeline.module.main_render.attribute.underwater_blur.description=Controls how blurry distant objects look underwater.
render_pipeline.module.main_render.attribute.underwater_distortion=Underwater Distortion
render_pipeline.module.main_render.attribute.underwater_distortion.description=Controls the animated wobble of the underwater view.
render_pipeline.module.main_render.attribute.sky_brightness=Sky Brightness
render_pipeline.module.main_render.attribute.sky_brightness.description=Brightness of the sky as you see it (and in refractions and cloud lighting). Does not change how much the sky lights the world.
render_pipeline.module.main_render.attribute.post_brightness=Image Brightness
render_pipeline.module.main_render.attribute.post_brightness.description=Brightens dark and mid tones after tone mapping; highlights are kept. 1.0 = off.
render_pipeline.module.main_render.attribute.post_saturation=Saturation
render_pipeline.module.main_render.attribute.post_saturation.description=Overall colour saturation. 1.0 = off.
render_pipeline.module.main_render.attribute.post_vibrance=Vibrance
render_pipeline.module.main_render.attribute.post_vibrance.description=Extra saturation for muted colours only. 0.0 = off.
render_pipeline.module.main_render.attribute.daylight_intensity=Daylight Intensity
render_pipeline.module.main_render.attribute.daylight_intensity.description=Overall daytime light level (sun, sky and clouds). Radiance's auto exposure is capped, so this is what makes the day brighter. Does not affect torches, caves or night.
render_pipeline.module.main_render.attribute.moonlight_intensity=Moonlight Intensity
render_pipeline.module.main_render.attribute.moonlight_intensity.description=Brightness of moonlight and the night sky.
render_pipeline.module.main_render.attribute.post_contrast=Contrast
render_pipeline.module.main_render.attribute.post_contrast.description=Gentle S-curve contrast. 0.0 = off.
render_pipeline.module.main_render.attribute.post_sharpen=Sharpening
render_pipeline.module.main_render.attribute.post_sharpen.description=Restores crisp texture detail softened by upscaling. 0.0 = off.
render_pipeline.module.main_render.attribute.linear_albedo=Linear Texture Colours
render_pipeline.module.main_render.attribute.linear_albedo.description=Decodes block textures and biome tints from sRGB before lighting (crisp pixels, true grass colour). Off = original Advanced look.
shader_pack_settings_screen.group.player=Player
render_pipeline.module.main_render.attribute.first_person_body=Player Model in First Person (experimental)
render_pipeline.module.main_render.attribute.first_person_body.description=Uses the player model instead of the floating first-person hands, so held items never clip into blocks.
render_pipeline.module.main_render.attribute.first_person_hide_hands=Hide Floating Hands
render_pipeline.module.main_render.attribute.first_person_hide_hands.description=Hides the usual first-person hands so the body's own arms are used instead.
render_pipeline.module.main_render.attribute.first_person_items_only=Only Held Items
render_pipeline.module.main_render.attribute.first_person_items_only.description=Hides the body (skin, cape) and keeps only the items held in the model's hands.
shader_pack_settings_screen.group.end=The End
render_pipeline.module.main_render.attribute.end_sky_beams=End Light Beams
render_pipeline.module.main_render.attribute.end_sky_beams.description=Brightness of the swaying light beams rising from the End horizon. 0 = off.
render_pipeline.module.main_render.attribute.end_sky_stars=End Stars
render_pipeline.module.main_render.attribute.end_sky_stars.description=Brightness of the stars in the End sky. 0 = off.
render_pipeline.module.main_render.attribute.first_person_show_armor=Show Armour
render_pipeline.module.main_render.attribute.first_person_show_armor.description=With "Only Held Items": keep the worn armour (and elytra) floating around you. The helmet is always hidden.
shader_pack_settings_screen.group.night_sky=Night Sky
render_pipeline.module.main_render.attribute.night_sky_stars=Stars
render_pipeline.module.main_render.attribute.night_sky_stars.description=Brightness of the star field (it turns with the sun and moon). 0 = off.
render_pipeline.module.main_render.attribute.night_sky_milky_way=Nebulae and Galaxies
render_pipeline.module.main_render.attribute.night_sky_milky_way.description=Brightness of the colourful nebula clouds along the galactic band (with their star clusters) and of the distant galaxies. 0 = off.
render_pipeline.module.main_render.attribute.vanilla_stars=Vanilla Stars
render_pipeline.module.main_render.attribute.vanilla_stars.description=Also draw the vanilla stars on top of the new night sky.
render_pipeline.module.main_render.attribute.aurora_mode=Aurora
render_pipeline.module.main_render.attribute.aurora_mode.off=Off
render_pipeline.module.main_render.attribute.aurora_mode.cold_biomes=Cold Biomes
render_pipeline.module.main_render.attribute.aurora_mode.every_night=Every Night
render_pipeline.module.main_render.attribute.aurora_mode.description=Northern lights at night. Cold Biomes: overhead in snowy biomes only. Every Night: everywhere, overhead in snowy biomes and low over the northern horizon elsewhere.
render_pipeline.module.main_render.attribute.aurora_strength=Aurora Brightness
render_pipeline.module.main_render.attribute.aurora_strength.description=Brightness of the northern lights (they also light up the ground a little).
render_pipeline.module.main_render.attribute.cirrus_amount=Cirrus Clouds
render_pipeline.module.main_render.attribute.cirrus_amount.description=Amount of thin, wispy high-altitude clouds above the normal clouds. They glow pink at sunset and are moonlit at night. 0 = off.
render_pipeline.module.main_render.attribute.cirrus_reflections=Cirrus Cloud Reflections
render_pipeline.module.main_render.attribute.cirrus_reflections.description=Show cirrus clouds in reflections on water and other smooth blocks.
render_pipeline.module.main_render.attribute.direct_lighting_mode=Direct Lighting Mode
render_pipeline.module.main_render.attribute.direct_lighting_mode.description=How light from emissive blocks (torches, lanterns, lava...) is sampled. ReSTIR: samples are reused over time and between neighbouring pixels, so the light is smooth but can lag or ghost when you move. RIS (Chromance): every pixel samples the lights from scratch each frame and traces its own shadow rays, no history and no ghosting, but noisier and it relies on the denoiser (DLSS Ray Reconstruction recommended). The settings of the ReSTIR group only work in ReSTIR mode, the RIS group only in RIS mode.
render_pipeline.module.main_render.attribute.lighting_mode.restir=ReSTIR
render_pipeline.module.main_render.attribute.lighting_mode.ris=RIS (Chromance)
render_pipeline.module.main_render.attribute.ris_samples=RIS Shadow Rays
render_pipeline.module.main_render.attribute.ris_samples.description=How many shadow rays to trace per pixel in RIS mode. More means less noise but slower.
render_pipeline.module.main_render.attribute.ris_candidates=RIS Candidates
render_pipeline.module.main_render.attribute.ris_candidates.description=How many lights are tried per sample in RIS mode before one is kept. More finds the best light more reliably where there are many lights, but costs more.
render_pipeline.module.main_render.attribute.ris_light_range=RIS Light Range
render_pipeline.module.main_render.attribute.ris_light_range.description=Distance in blocks where block light fades out completely in RIS mode (Chromance uses 12). 0 means no limit, like ReSTIR.
render_pipeline.module.main_render.attribute.ris_sample_clamp=RIS Speckle Limit
render_pipeline.module.main_render.attribute.ris_sample_clamp.description=Largest brightness a single light sample may add in RIS mode, to cut rare bright speckles. 0 means off.
shader_pack_settings_screen.group.ris=RIS (Chromance)
render_pipeline.module.main_render.attribute.nether_fog=Nether Fog
render_pipeline.module.main_render.attribute.nether_fog.description=Enables or disables distance fog in the Nether.
render_pipeline.module.main_render.attribute.end_fog=End Fog
render_pipeline.module.main_render.attribute.end_fog.description=Enables or disables distance fog on islands in The End (keeps the custom End sky visible).
render_pipeline.module.main_render.attribute.waving_foliage=Waving Foliage
render_pipeline.module.main_render.attribute.waving_foliage.description=Gentle wind animation for grass, flowers, crops and leaves.
render_pipeline.module.main_render.attribute.vanilla_sun=Vanilla Sun
render_pipeline.module.main_render.attribute.vanilla_sun.description=Use the vanilla Minecraft sun texture instead of the shader's 3D sun.
